---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarIcon from '../components/StarIcon.astro';
import { getToolsByCategory, toolCategories, type ToolCategory } from '../tools';

const sections = Object.entries(toolCategories)
  .map(([category, label]) => ({
    label,
    tools: getToolsByCategory(category as ToolCategory),
  }))
  .filter((section) => section.tools.length > 0);
---

<BaseLayout title="二次元风的本地工具箱">
  <section class="mb-12 pt-6 text-center">
    <h1 class="hero-title text-4xl font-bold tracking-tight text-white sm:text-5xl">
      YouRen工具箱
    </h1>
    <p class="hero-sub mx-auto mt-4 max-w-xl text-sm leading-relaxed text-white/90 sm:text-base">
      黄昏与星空之间，小工具各自发光。
      <br />
      所有处理都在你自己的浏览器里完成，文件不上传服务器。
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      <span class="chip">🔒 隐私优先</span>
      <span class="chip">⚡ 无需登录</span>
      <span class="chip">🌸 免费开源</span>
    </div>
  </section>

  {sections.map((section) => (
    <section class="mb-10">
      <h2 class="hero-sub mb-4 flex items-center gap-2 text-lg font-semibold text-white">
        <StarIcon class="h-4 w-4" />
        {section.label}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {section.tools.map((tool) => (
          <a href={`/tools/${tool.slug}/`} class="card card-hoverable">
            <div class="flex items-start gap-3">
              <span aria-hidden class="text-2xl leading-none">
                {tool.icon}
              </span>
              <div>
                <strong class="text-neutral-800">{tool.title}</strong>
                <p class="mt-1 text-xs leading-relaxed text-neutral-600">{tool.description}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

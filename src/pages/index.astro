---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getToolsByCategory, toolCategories, type ToolCategory } from '../tools';

const sections = Object.entries(toolCategories)
  .map(([category, label]) => ({
    label,
    tools: getToolsByCategory(category as ToolCategory),
  }))
  .filter((section) => section.tools.length > 0);
---

<BaseLayout title="纯本地处理的在线工具箱">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-bold tracking-tight">茉莉工具箱</h1>
    <p class="mx-auto mt-3 max-w-xl text-neutral-500">
      小而快的中文在线工具集。所有处理都在你自己的浏览器里完成，文件不上传服务器。
    </p>
    <p class="mt-3 inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs text-brand-700">
      🔒 隐私优先 · 无需登录 · 免费开源
    </p>
  </section>

  {sections.map((section) => (
    <section class="mb-10" id={section.label}>
      <h2 class="mb-3 text-lg font-semibold">{section.label}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {section.tools.map((tool) => (
          <a
            href={`/tools/${tool.slug}/`}
            class="card transition hover:border-brand-500 hover:shadow-sm"
          >
            <div class="flex items-start gap-3">
              <span aria-hidden class="text-2xl leading-none">
                {tool.icon}
              </span>
              <div>
                <strong>{tool.title}</strong>
                <p class="mt-1 text-xs leading-relaxed text-neutral-500">{tool.description}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const siteName = '茉莉工具箱';
const repoUrl = 'https://github.com/YouRen1320/moli-tools';
const { title, description = '所有工具均在浏览器本地运行，文件不上传服务器。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {siteName}</title>
  </head>
  <body class="flex min-h-full flex-col font-sans">
    <header class="border-b border-neutral-200 bg-white">
      <div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between px-4">
        <a href="/" class="flex items-center gap-2 font-bold">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 text-sm text-white">
            茉
          </span>
          <span>{siteName}</span>
        </a>
        <nav class="flex items-center gap-4 text-sm text-neutral-600">
          <a href="/" class="transition hover:text-brand-600">
            工具
          </a>
          <a
            href={repoUrl}
            class="transition hover:text-brand-600"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-neutral-200 bg-white">
      <div class="mx-auto w-full max-w-5xl px-4 py-4 text-center text-xs text-neutral-500">
        所有处理均在你自己的浏览器内完成，文件不会上传到任何服务器 · MIT License ·
        <a class="transition hover:text-brand-600" href={repoUrl}>
          YouRen1320/moli-tools
        </a>
      </div>
    </footer>
  </body>
</html>
